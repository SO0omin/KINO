# ---------------------------------------------------------------
# 로컬 개발용 비밀 설정 양식
#
# 1. 이 파일을 복사해 application-secret.properties 로 이름을 바꿉니다.
# 2. 값을 채웁니다. 키는 팀 담당자에게 DM으로 받으세요.
# 3. application-secret.properties 는 .gitignore 로 차단되어 커밋되지 않습니다.
# ---------------------------------------------------------------

# 결제 (토스페이먼츠 테스트 키)
toss.secret-key=

# 소셜 로그인
kakao.rest-api-key=
kakao.client-secret=
naver.client-id=
naver.client-secret=
google.client-id=
google.client-secret=

# 메일 발송 (Gmail 앱 비밀번호)
spring.mail.username=
spring.mail.password=

# SMS 인증 (Solapi)
# 키가 없다면 비워두고 아래 개발 모드를 켜세요. 실제 문자 없이 화면에 인증번호가 표시됩니다.
solapi.api-key=
solapi.api-secret=
solapi.from-number=
sms.mock-enabled=true
